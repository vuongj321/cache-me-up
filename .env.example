# ---------------------------------------------------------------------------
# Daily Tech Digest — environment template
# Copy to `.env` (gitignored) for local runs:  cp .env.example .env
# In CI these are provided as GitHub Actions secrets/variables.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# API key for the LLM chat-completions call.
OPENAI_API_KEY=sk-replace-me

# Discord webhook URL (Channel settings -> Integrations -> Webhooks -> Copy URL).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/replace-me

# --- Optional: LLM provider -------------------------------------------------

# Default model name.
OPENAI_MODEL=gpt-4o-mini

# Point at any OpenAI-compatible provider (e.g. https://api.openai.com/v1).
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Optional: pipeline tuning ---------------------------------------------

# How far back a fetched item may be published (hours).
LOOKBACK_HOURS=36

# Max candidates handed to the LLM (keeps token cost + latency bounded).
MAX_CANDIDATES=30

# Seen-cache file (persisted via actions/cache in CI).
SEEN_STORE_PATH=data/seen.json

# Days a delivered item stays suppressed.
SEEN_WINDOW_DAYS=5

# Legacy: how long "considered" entries written by older versions are kept before
# they age out. Nothing writes that tier any more — only posted items are cached.
CONSIDERED_WINDOW_DAYS=2

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Post a short "nothing new worth sharing today" note when nothing qualifies.
# Set to "false" to stay silent instead.
DIGEST_POST_EMPTY=true

# Per-request HTTP timeout for fetchers (ms).
FETCH_TIMEOUT_MS=20000

# Timeout for the LLM chat-completions call (ms).
LLM_TIMEOUT_MS=120000

# Max tokens the model may write in one reply. Raise this if a run fails with
# "LLM output was truncated ... hit max_tokens=" (a truncated JSON reply cannot
# be parsed, so the run stops instead of posting a partial digest).
LLM_MAX_OUTPUT_TOKENS=6000

# Optional GitHub token; raises the API rate limit used by the github-search fetcher.
GITHUB_TOKEN=

# Optional: cap how many items one source may contribute to the LLM input.
MAX_ITEMS_PER_SOURCE=12
